# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
#
# BUILD-TIME (NEXT_PUBLIC_*) — baked into the client bundle by `next build`.
#   Changing these requires docker compose build + redeploy.
#
# RUNTIME-ONLY — read by the server at startup.
#   Can be updated by editing .env.local and restarting the container.
# ─────────────────────────────────────────────────────────────────────────────


# ── Build-time / public ───────────────────────────────────────────────────────

# Your Supabase project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical public URL of your deployment.
# Used for auth redirects. Use http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ── Runtime-only (server-side secrets) ───────────────────────────────────────

# Supabase service-role key — full DB access, keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to authenticate /api/cron/process-recurring.
# REQUIRED in production — the app crashes on startup without this.
CRON_SECRET=change-me-to-a-long-random-string

# (Optional) Google Gemini API key for AI transaction categorization.
GEMINI_API_KEY=

# (Optional) Slack / Discord webhook URL for security event alerts.
SECURITY_WEBHOOK_URL=
